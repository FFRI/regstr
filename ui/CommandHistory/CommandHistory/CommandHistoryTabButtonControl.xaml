<fluent:Button
    x:Class="CommandHistory.CommandHistoryTabButtonControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="urn:fluent-ribbon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommandHistory"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:CommandHistoryTabButtonViewModel}"
    Header="Command history"
    ToolTip="Record and replay a command."
    LargeIcon="pack://application:,,,/DbgX.CommandHistory;component/Resources/command_history_32.png"
    Icon="pack://application:,,,/DbgX.CommandHistory;component/Resources/command_history_16.png"
    Size="Large"
    Command="{Binding OpenCommandHistoryToolWindow}" />
