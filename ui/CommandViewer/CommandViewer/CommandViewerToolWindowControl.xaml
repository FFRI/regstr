<ui:ToolWindowView
    x:Class="CommandViewer.CommandViewerToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="clr-namespace:DbgX.Interfaces.UI;assembly=DbgX.Interfaces"
    xmlns:local="clr-namespace:CommandViewer"
    xmlns:events="clr-namespace:DbgX.Interfaces.Events;assembly=DbgX.Interfaces.Internal"
    mc:Ignorable="d"
    ui:ToolWindowView.IsWindowPersisted="true"
    d:DataContext="{d:DesignInstance local:CommandViewerToolWindowViewModel}"
    d:DesignHeight="450" d:DesignWidth="800">

    <ui:ToolWindowView.TabTitle>
        <ui:ToolWindowTitle
            Title="Command Viewer"
            ToolTip="Execute a command step by step." />
    </ui:ToolWindowView.TabTitle>

    <ui:ToolWindowView.Resources>
        <local:RefreshKindValueConverter x:Key="RefreshKindConverter" />
        <local:DiffValueConverter x:Key="DiffConverter" />
        <local:DiffTextBoxValueConverter x:Key="DiffTextBoxConverter" />
    </ui:ToolWindowView.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandInputTextBox" Grid.Column="0" Margin="4,4,4,0"
                     FontFamily="Consolas"
                     Text="{Binding CommandInput, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}"
                     SourceUpdated="CommandInputTextBox_OnSourceUpdated" />
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="4,0,4,0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <WrapPanel Orientation="Horizontal">
                <WrapPanel.Resources>
                    <Style TargetType="CheckBox">
                        <Setter Property="Margin" Value="4,0,0,0" />
                    </Style>
                </WrapPanel.Resources>
                <CheckBox Content="Memory"
                          IsChecked="{Binding Path=RefreshKindMask,
                                              Converter={StaticResource RefreshKindConverter},
                                              ConverterParameter={x:Static events:RefreshKind.Memory} }"/>
                <CheckBox Content="Registers" IsChecked="{Binding Path=RefreshKindMask,
                     Converter={StaticResource RefreshKindConverter},
                     ConverterParameter={x:Static events:RefreshKind.Registers} }"/>
                <!-- DebuggerState を監視すると dps 等で無限ループ状態になるため、書かない -->
                <CheckBox Content="Scope" IsChecked="{Binding Path=RefreshKindMask,
                     Converter={StaticResource RefreshKindConverter},
                     ConverterParameter={x:Static events:RefreshKind.Scope} }"/>
                <CheckBox Content="SrcSymPaths" IsChecked="{Binding Path=RefreshKindMask,
                     Converter={StaticResource RefreshKindConverter},
                     ConverterParameter={x:Static events:RefreshKind.SrcSymPaths} }"/>
                <!-- ConnectionState は OnTargetInitialized で代用できるため、書かない -->
                <CheckBox Content="Breakpoints" IsChecked="{Binding Path=RefreshKindMask,
                     Converter={StaticResource RefreshKindConverter},
                     ConverterParameter={x:Static events:RefreshKind.Breakpoints} }"/>
                <CheckBox Content="EventFilters" IsChecked="{Binding Path=RefreshKindMask,
                     Converter={StaticResource RefreshKindConverter},
                     ConverterParameter={x:Static events:RefreshKind.EventFilters} }"/>
                <CheckBox Content="Views" IsChecked="{Binding Path=RefreshKindMask,
                     Converter={StaticResource RefreshKindConverter},
                     ConverterParameter={x:Static events:RefreshKind.Views} }"/>
                <CheckBox Content="Modules" IsChecked="{Binding Path=RefreshKindMask,
                     Converter={StaticResource RefreshKindConverter},
                     ConverterParameter={x:Static events:RefreshKind.Modules} }"/>
                <CheckBox Content="StepFilters" IsChecked="{Binding Path=RefreshKindMask,
                     Converter={StaticResource RefreshKindConverter},
                     ConverterParameter={x:Static events:RefreshKind.StepFilters} }"/>
            </WrapPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="2" Margin="4,0,4,0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Margin="4,4,0,0" FontSize="14" FontFamily="Consolas">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0,3}/{1,3}">
                                <Binding Path="History.CommandHistoryPosView" />
                                <Binding Path="History.Count" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button Margin="4,4,0,0" Content="&lt;" Command="{Binding PrevHistoryCommand}"/>
                    <Button Margin="4,4,0,0" Content="&gt;" Command="{Binding NextHistoryCommand}"/>
                    <Button Margin="20,4,0,0" Content="Delete" Command="{Binding DeleteHistoryCommand}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Margin="4,4,0,0" IsEditable="False" FontFamily="Consolas" Width="60"
                          ItemsSource="{Binding DiffChunkerKinds}"
                          SelectedItem="{Binding SelectedDiffChunkerKind, Mode=TwoWay}"
                          ToolTip="Chunk type for textual differences."/>
                    <CheckBox Margin="4,4,0,0" Content="Always record" ToolTip="Always record a history entry, even when the value has not changed." IsChecked="{Binding IsAlwaysRecord}"/>
                    <CheckBox Margin="4,4,0,0" Content="Text wrapping" IsChecked="{Binding IsWrapText}"/>
                </StackPanel>
            </DockPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="3" Margin="4,4,4,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="{Binding WrapTextTypeScrollBar}"
                      CanContentScroll="True">
            <Border BorderThickness="1"
                    BorderBrush="Gray"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    TextOptions.TextFormattingMode="Display"
                    Padding="0">
                <Grid>
                    <!-- 表示用 -->
                    <local:TextBlock2 x:Name="CommandOutputTextBlock"
                                      TextWrapping="{Binding WrapTextType}"
                                      FontFamily="Consolas"
                                      Padding="2,0,0,0"
                                      Visibility="Visible"
                                      Inlines2="{Binding CommandOutputDiff, Converter={StaticResource DiffConverter}}"
                                      MouseLeftButtonDown="CommandOutputTextBlock_OnMouseLeftButtonDown">
                    </local:TextBlock2>
                    <!-- 選択用 -->
                    <TextBox x:Name="CommandOutputTextBox"
                             Visibility="Collapsed"
                             FontFamily="Consolas"
                             Padding="0"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             Text="{Binding CommandOutputDiff, Converter={StaticResource DiffTextBoxConverter}}"
                             TextWrapping="{Binding WrapTextType}"
                             PreviewLostKeyboardFocus="CommandOutputTextBox_OnPreviewLostKeyboardFocus" />
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</ui:ToolWindowView>
