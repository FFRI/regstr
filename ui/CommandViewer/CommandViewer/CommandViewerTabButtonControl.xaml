<fluent:Button
    x:Class="CommandViewer.CommandViewerTabButtonControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="urn:fluent-ribbon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommandViewer"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:CommandViewerTabButtonViewModel}"
    Header="Command viewer"
    ToolTip="Execute a command step by step."
    LargeIcon="pack://application:,,,/CommandViewer;component/Resources/command_viewer_32.png"
    Icon="pack://application:,,,/CommandViewer;component/Resources/command_viewer_16.png"
    Size="Large"
    Command="{Binding OpenCommandViewerToolWindow}" />
